{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Swap Display Dash",
  "version": "0.2.0",
  "identifier": "com.minhaempresa.swapdisplaydash",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Swap Display Dash",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3NDY5OTg0MkVGRTY4MkQKUldRdGFQNHVoSmxHSjVUWWs3SkVxUE9yTkhHQzNRcVA3WkNCKzVQRW1WYThrWno3OVliSjBUUkkK",
      "endpoints": [
        "https://github.com/SOZARADRION/swap-display-dash/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
