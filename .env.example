# Cliente web/desktop: use somente URL e chave publicavel do seu projeto.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA

# Contexto de servidor: use os mesmos valores publicos quando necessario.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA

# Opcional: exigido apenas ao usar o cliente administrativo no servidor.
# Nunca prefixe esta chave com VITE_ nem inclua em builds desktop.
# SUPABASE_SERVICE_ROLE_KEY=
